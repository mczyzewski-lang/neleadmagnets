# Publiczny adres serwisu (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://nowyetap.pl

# --- E-mail (Resend: https://resend.com) ---
# Bez tych zmiennych opcja „Wyślij na e-mail” jest ukryta, a użytkownik widzi informację,
# że może pobrać lub wydrukować wynik. Aplikacja NIE udaje wysyłki.
RESEND_API_KEY=
EMAIL_FROM="Nowy Etap <narzedzia@twojadomena.pl>"
# Opcjonalnie: adres, na który trafiają powiadomienia o nowych zgłoszeniach kontaktowych
LEADS_NOTIFY_EMAIL=

# --- CRM (webhook) ---
# Zgłoszenia (tylko dane kontaktowe, zgody, typ prośby, UTM — bez odpowiedzi z narzędzi)
# trafiają POST-em na ten adres, podpisane HMAC-SHA256 w nagłówku X-NE-Signature.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Analityka (opcjonalnie) ---
# GTM ładuje się dopiero po zgodzie w banerze cookies. Bez tej zmiennej baner się nie pokazuje,
# a strona nie używa żadnych cookies analitycznych.
NEXT_PUBLIC_GTM_ID=
